<odoo>
    <record id="view_sales_route_license_activation_wizard" model="ir.ui.view">
        <field name="name">sales.route.license.activation.wizard.form</field>
        <field name="model">sales.route.license.activation.wizard</field>
        <field name="arch" type="xml">
            <form string="Activate License">
                <group>
                    <field name="license_id" invisible="1"/>
                    <field name="activation_code" placeholder="Paste activation code here..."/>
                </group>
                <footer>
                    <button name="action_activate" type="object" string="Activate / Renew" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
