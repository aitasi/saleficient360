<odoo>
    <record id="view_route_sale_terminal_wizard_form" model="ir.ui.view">
        <field name="name">route.sale.terminal.wizard.form</field>
        <field name="model">route.sale.terminal.wizard</field>
        <field name="arch" type="xml">
            <form string="Route Sales Terminal" create="false" edit="true">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="plan_line_id" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Product Grid - enter quantities to add"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false" decoration-success="qty &gt; 0">
                            <field name="product_id"/>
                            <field name="default_code"/>
                            <field name="uom_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm_order" string="Create / Update Order" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
