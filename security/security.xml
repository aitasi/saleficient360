<odoo>
    <record id="group_field_sales_user" model="res.groups">
        <field name="name">Field Sales User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_field_sales_supervisor" model="res.groups">
        <field name="name">Field Sales Supervisor</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>

    <record id="group_field_sales_manager" model="res.groups">
        <field name="name">Field Sales Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>

    <record id="group_stock_van_loading_manager" model="res.groups">
        <field name="name">Stock and VAN Loading Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Store-manager role restricted to depot, VAN/vehicle and VAN stock loading operations.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <record id="group_field_sales_quick_sale_unrestricted" model="res.groups">
        <field name="name">Field Sales Quick Sales Order Creator</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Allows selected sales users to open Quick Sales Order from My Field Work and create POS-style sales orders for any client on any route without being a supervisor or manager.</field>
        <field name="implied_ids" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>

    <record id="rule_route_plan_own_user" model="ir.rule">
        <field name="name">Field Sales Route Plans: own records only</field>
        <field name="model_id" ref="model_sales_route_plan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_route_plan_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Route Plans: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_route_plan_line_own_user" model="ir.rule">
        <field name="name">Field Sales Route Plan Lines: own records only</field>
        <field name="model_id" ref="model_sales_route_plan_line"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_route_plan_line_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Route Plan Lines: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_plan_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_route_visit_own_user" model="ir.rule">
        <field name="name">Field Sales Route Visits: own records only</field>
        <field name="model_id" ref="model_sales_route_visit"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_route_visit_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Route Visits: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_route_target_own_user" model="ir.rule">
        <field name="name">Field Sales Targets: own salesperson targets only</field>
        <field name="model_id" ref="model_sales_route_target"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('user_id', '=', False), ('route_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_route_target_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Targets: supervisor team targets</field>
        <field name="model_id" ref="model_sales_route_target"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>


    <record id="rule_sales_route_internal_all_read" model="ir.rule">
        <field name="name">Market Routes: internal users can select existing routes</field>
        <field name="model_id" ref="model_sales_route"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sales_route_user_routes" model="ir.rule">
        <field name="name">Field Sales Routes: salesperson assigned routes</field>
        <field name="model_id" ref="model_sales_route"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('user_ids', 'in', [user.id]), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_sales_route_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Routes: supervisor team routes</field>
        <field name="model_id" ref="model_sales_route"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_sale_order_field_user_own" model="ir.rule">
        <field name="name">Field Sales Sale Orders: own records only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('route_plan_line_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_sale_order_field_supervisor_all" model="ir.rule">
        <field name="name">Field Sales Sale Orders: supervisor team records</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>


    <record id="rule_device_status_own_user" model="ir.rule">
        <field name="name">Field Device Status: own status only</field>
        <field name="model_id" ref="model_sales_route_device_status"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_device_status_supervisor_all" model="ir.rule">
        <field name="name">Field Device Status: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_device_status"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_sales_route_ai_chat_own_user" model="ir.rule">
        <field name="name">AI Chat Assistant: own chats only</field>
        <field name="model_id" ref="model_sales_route_ai_chat"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_sales_route_ai_chat_supervisor_all" model="ir.rule">
        <field name="name">AI Chat Assistant: supervisor team chats</field>
        <field name="model_id" ref="model_sales_route_ai_chat"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>

    <record id="rule_merchandising_audit_own_user" model="ir.rule">
        <field name="name">Merchandising Audits: own records</field>
        <field name="model_id" ref="model_sales_route_merchandising_audit"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_merchandising_audit_supervisor_all" model="ir.rule">
        <field name="name">Merchandising Audits: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_merchandising_audit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>
    <record id="rule_smart_reminder_own_user" model="ir.rule">
        <field name="name">Smart Reminders: own records</field>
        <field name="model_id" ref="model_sales_route_smart_reminder"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_smart_reminder_supervisor_all" model="ir.rule">
        <field name="name">Smart Reminders: supervisor team records</field>
        <field name="model_id" ref="model_sales_route_smart_reminder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
    </record>
    <record id="rule_game_score_own_user" model="ir.rule">
        <field name="name">Gamification: own score only</field>
        <field name="model_id" ref="model_sales_route_game_score"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_user'))]"/>
    </record>
    <record id="rule_game_score_supervisor_all" model="ir.rule">
        <field name="name">Gamification: supervisor team scores</field>
        <field name="model_id" ref="model_sales_route_game_score"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_supervisor'))]"/>
