    </record>


    <!-- Sales Manager: can see supervisors assigned to them and the salespeople under those supervisors. -->
    <record id="rule_route_plan_manager_team" model="ir.rule"><field name="name">Field Sales Route Plans: manager team records</field><field name="model_id" ref="model_sales_route_plan"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_route_plan_line_manager_team" model="ir.rule"><field name="name">Field Sales Route Plan Lines: manager team records</field><field name="model_id" ref="model_sales_route_plan_line"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_route_visit_manager_team" model="ir.rule"><field name="name">Field Sales Route Visits: manager team records</field><field name="model_id" ref="model_sales_route_visit"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_route_target_manager_team" model="ir.rule"><field name="name">Field Sales Targets: manager team records</field><field name="model_id" ref="model_sales_route_target"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_sales_route_manager_team" model="ir.rule"><field name="name">Field Sales Routes: manager team routes</field><field name="model_id" ref="model_sales_route"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_sale_order_field_manager_team" model="ir.rule"><field name="name">Field Sales Sale Orders: manager team records</field><field name="model_id" ref="sale.model_sale_order"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_device_status_manager_team" model="ir.rule"><field name="name">Field Device Status: manager team records</field><field name="model_id" ref="model_sales_route_device_status"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_ai_chat_manager_team" model="ir.rule"><field name="name">AI Chat Assistant: manager team records</field><field name="model_id" ref="model_sales_route_ai_chat"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
    <record id="rule_merchandising_audit_manager_team" model="ir.rule"><field name="name">Merchandising Audits: manager team records</field><field name="model_id" ref="model_sales_route_merchandising_audit"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('field_sales_route_plan.group_field_sales_manager'))]"/></record>
