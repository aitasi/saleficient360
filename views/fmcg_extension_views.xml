<odoo>
    <record id="view_fmcg_depot_tree" model="ir.ui.view">
        <field name="name">fmcg.depot.tree</field>
        <field name="model">fmcg.depot</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="code"/><field name="distributor_id"/><field name="user_id"/><field name="active"/></tree></field>
    </record>
    <record id="view_fmcg_depot_form" model="ir.ui.view">
        <field name="name">fmcg.depot.form</field>
        <field name="model">fmcg.depot</field>
        <field name="arch" type="xml">
            <form string="Depot"><sheet><group><group><field name="name"/><field name="code"/><field name="partner_id"/><field name="distributor_id"/></group><group><field name="user_id"/><field name="active"/><field name="route_ids" widget="many2many_tags"/></group></group><notebook><page string="Notes"><field name="location_note"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form>
        </field>
    </record>
    <record id="action_fmcg_depot" model="ir.actions.act_window"><field name="name">Depots</field><field name="res_model">fmcg.depot</field><field name="view_mode">tree,form</field></record>

    <record id="view_fmcg_van_vehicle_tree" model="ir.ui.view"><field name="name">fmcg.van.vehicle.tree</field><field name="model">fmcg.van.vehicle</field><field name="arch" type="xml"><tree><field name="name"/><field name="plate_number"/><field name="depot_id"/><field name="user_id"/><field name="route_id"/><field name="active"/></tree></field></record>
    <record id="view_fmcg_van_vehicle_form" model="ir.ui.view"><field name="name">fmcg.van.vehicle.form</field><field name="model">fmcg.van.vehicle</field><field name="arch" type="xml"><form string="VAN / Vehicle"><sheet><group><group><field name="name"/><field name="plate_number"/><field name="depot_id"/></group><group><field name="user_id"/><field name="route_id"/><field name="active"/></group></group><field name="capacity_note"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="action_fmcg_van_vehicle" model="ir.actions.act_window"><field name="name">VANs / Vehicles</field><field name="res_model">fmcg.van.vehicle</field><field name="view_mode">tree,form</field></record>

    <record id="view_fmcg_van_stock_load_tree" model="ir.ui.view"><field name="name">fmcg.van.stock.load.tree</field><field name="model">fmcg.van.stock.load</field><field name="arch" type="xml"><tree><field name="date"/><field name="name"/><field name="depot_id"/><field name="van_id"/><field name="user_id"/><field name="route_id"/><field name="state"/></tree></field></record>
    <record id="view_fmcg_van_stock_load_form" model="ir.ui.view"><field name="name">fmcg.van.stock.load.form</field><field name="model">fmcg.van.stock.load</field><field name="arch" type="xml"><form string="VAN Stock Load"><header><button name="action_loaded" type="object" string="Mark Loaded" class="btn-primary" states="draft"/><button name="action_dispatch" type="object" string="Dispatch" class="btn-primary" states="loaded"/><button name="action_reconcile" type="object" string="Reconciled" class="btn-primary" states="dispatched"/><button name="action_cancel" type="object" string="Cancel" states="draft,loaded,dispatched"/><field name="state" widget="statusbar" statusbar_visible="draft,loaded,dispatched,reconciled"/></header><sheet><group><group><field name="name"/><field name="date"/><field name="depot_id"/></group><group><field name="van_id"/><field name="user_id"/><field name="route_id"/></group></group><notebook><page string="Products"><field name="line_ids"><tree editable="bottom"><field name="product_id"/><field name="qty_loaded"/><field name="qty_sold"/><field name="qty_returned"/><field name="qty_damaged"/><field name="qty_variance" readonly="1"/></tree></field></page><page string="Notes"><field name="note"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="action_fmcg_van_stock_load" model="ir.actions.act_window"><field name="name">VAN Stock Loads</field><field name="res_model">fmcg.van.stock.load</field><field name="view_mode">tree,form,pivot,graph</field></record>

    <record id="view_fmcg_van_reconciliation_tree" model="ir.ui.view"><field name="name">fmcg.van.reconciliation.tree</field><field name="model">fmcg.van.reconciliation</field><field name="arch" type="xml"><tree><field name="date"/><field name="name"/><field name="load_id"/><field name="van_id"/><field name="user_id"/><field name="total_cash"/><field name="total_mobile_money"/><field name="total_cheque"/><field name="variance_amount"/><field name="state"/></tree></field></record>
    <record id="view_fmcg_van_reconciliation_form" model="ir.ui.view"><field name="name">fmcg.van.reconciliation.form</field><field name="model">fmcg.van.reconciliation</field><field name="arch" type="xml"><form string="VAN Reconciliation"><header><button name="action_submit" type="object" string="Submit" class="btn-primary" states="draft"/><button name="action_approve" type="object" string="Approve" class="btn-primary" states="submitted" groups="field_sales_route_plan.group_field_sales_manager"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="date"/><field name="load_id"/><field name="van_id"/><field name="user_id"/></group><group><field name="currency_id" invisible="1"/><field name="total_cash"/><field name="total_mobile_money"/><field name="total_cheque"/><field name="variance_amount"/></group></group><field name="note"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="action_fmcg_van_reconciliation" model="ir.actions.act_window"><field name="name">VAN Reconciliations</field><field name="res_model">fmcg.van.reconciliation</field><field name="view_mode">tree,form,pivot,graph</field></record>

    <record id="view_fmcg_market_impact_campaign_tree" model="ir.ui.view"><field name="name">fmcg.market.impact.campaign.tree</field><field name="model">fmcg.market.impact.campaign</field><field name="arch" type="xml"><tree><field name="name"/><field name="date_start"/><field name="date_end"/><field name="budget"/><field name="state"/></tree></field></record>
    <record id="view_fmcg_market_impact_campaign_form" model="ir.ui.view"><field name="name">fmcg.market.impact.campaign.form</field><field name="model">fmcg.market.impact.campaign</field><field name="arch" type="xml"><form string="Market Impact Campaign"><header><button name="action_activate" type="object" string="Activate" class="btn-primary" states="draft"/><button name="action_done" type="object" string="Close" class="btn-primary" states="active"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="date_start"/><field name="date_end"/><field name="budget"/></group><group><field name="currency_id" invisible="1"/><field name="route_ids" widget="many2many_tags"/><field name="user_ids" widget="many2many_tags"/></group></group><field name="objective"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="view_fmcg_market_impact_campaign_calendar" model="ir.ui.view"><field name="name">fmcg.market.impact.campaign.calendar</field><field name="model">fmcg.market.impact.campaign</field><field name="arch" type="xml"><calendar string="Market Impact Campaigns" date_start="date_start" date_stop="date_end" color="state"><field name="name"/><field name="state"/><field name="budget"/></calendar></field></record>

    <record id="action_fmcg_market_impact_campaign" model="ir.actions.act_window"><field name="name">Market Impact Campaigns</field><field name="res_model">fmcg.market.impact.campaign</field><field name="view_mode">tree,form,calendar,pivot,graph</field></record>

    <record id="view_fmcg_promotion_scheme_tree" model="ir.ui.view"><field name="name">fmcg.promotion.scheme.tree</field><field name="model">fmcg.promotion.scheme</field><field name="arch" type="xml"><tree><field name="name"/><field name="date_start"/><field name="date_end"/><field name="channel"/><field name="state"/></tree></field></record>
    <record id="view_fmcg_promotion_scheme_form" model="ir.ui.view"><field name="name">fmcg.promotion.scheme.form</field><field name="model">fmcg.promotion.scheme</field><field name="arch" type="xml"><form string="Trade Promotion"><header><button name="action_approve" type="object" string="Approve" states="draft" class="btn-primary"/><button name="action_activate" type="object" string="Activate" states="approved" class="btn-primary"/><button name="action_close" type="object" string="Close" states="active"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="date_start"/><field name="date_end"/><field name="channel"/></group><group><field name="route_ids" widget="many2many_tags"/><field name="product_ids" widget="many2many_tags"/></group></group><field name="mechanic"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="view_fmcg_promotion_scheme_calendar" model="ir.ui.view"><field name="name">fmcg.promotion.scheme.calendar</field><field name="model">fmcg.promotion.scheme</field><field name="arch" type="xml"><calendar string="Trade Promotions" date_start="date_start" date_stop="date_end" color="state"><field name="name"/><field name="channel"/><field name="state"/></calendar></field></record>

    <record id="action_fmcg_promotion_scheme" model="ir.actions.act_window"><field name="name">Trade Promotions</field><field name="res_model">fmcg.promotion.scheme</field><field name="view_mode">tree,form,calendar,pivot,graph</field></record>

    <record id="view_partner_form_fmcg_extensions" model="ir.ui.view">
        <field name="name">res.partner.form.fmcg.extensions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="FMCG / Route Intelligence">
                    <group>
                        <group><field name="fmcg_partner_type"/><field name="trade_channel"/><field name="route_id"/><field name="depot_id"/></group>
                        <group><field name="distributor_id"/><field name="credit_limit_amount"/><field name="credit_hold"/><field name="route_sales_potential"/></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_fmcg_operations" name="FMCG Operations" parent="field_sales_route_plan.menu_field_sales_root" sequence="40" groups="field_sales_route_plan.group_field_sales_user,field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,field_sales_route_plan.group_stock_van_loading_manager"/>
    <menuitem id="menu_fmcg_depot" name="Depots" parent="menu_fmcg_operations" action="action_fmcg_depot" sequence="10" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,field_sales_route_plan.group_stock_van_loading_manager"/>
    <menuitem id="menu_fmcg_van_vehicle" name="VANs / Vehicles" parent="menu_fmcg_operations" action="action_fmcg_van_vehicle" sequence="20" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,field_sales_route_plan.group_stock_van_loading_manager"/>
    <menuitem id="menu_fmcg_van_stock_load" name="VAN Stock Loads" parent="menu_fmcg_operations" action="action_fmcg_van_stock_load" sequence="30" groups="field_sales_route_plan.group_field_sales_user,field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,field_sales_route_plan.group_stock_van_loading_manager"/>
    <menuitem id="menu_fmcg_van_reconciliation" name="VAN Reconciliations" parent="menu_fmcg_operations" action="action_fmcg_van_reconciliation" sequence="40" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager"/>
    <menuitem id="menu_fmcg_market_impact_campaign" name="Market Impact Campaigns" parent="menu_fmcg_operations" action="action_fmcg_market_impact_campaign" sequence="50" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager"/>
    <menuitem id="menu_fmcg_promotion_scheme" name="Trade Promotions" parent="menu_fmcg_operations" action="action_fmcg_promotion_scheme" sequence="60" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager"/>
</odoo>
