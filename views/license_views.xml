<odoo>
    <record id="view_sales_route_license_tree" model="ir.ui.view">
        <field name="name">sales.route.license.tree</field>
        <field name="model">sales.route.license</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state in ('expired','blocked')" decoration-warning="state == 'expiring'" decoration-success="state in ('active','trial')">
                <field name="name"/>
                <field name="company_id"/>
                <field name="plan_type"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sales_route_license_form" model="ir.ui.view">
        <field name="name">sales.route.license.form</field>
        <field name="model">sales.route.license</field>
        <field name="arch" type="xml">
            <form string="Field Sales License">
                <header>
                    <button name="action_open_activation_wizard" type="object" string="Activate / Renew License" class="btn-primary" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="trial,active,expiring,expired,blocked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="License Details">
                            <field name="company_id"/>
                            <field name="license_key" readonly="1"/>
                            <field name="activation_fingerprint" readonly="1" groups="base.group_system"/>
                            <field name="plan_type"/>
                            <field name="active" groups="base.group_system"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="days_remaining" readonly="1"/>
                            <field name="warning_days"/>
                            <field name="grace_days"/>
                        </group>
                    </group>
                    <group string="Limits">
                        <field name="max_users" readonly="1"/>
                        <field name="activated_by_id" readonly="1"/>
                        <field name="activation_date" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal license notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sales_route_license" model="ir.actions.act_window">
        <field name="name">License Management</field>
        <field name="res_model">sales.route.license</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
