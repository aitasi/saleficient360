<odoo>
    <record id="view_route_plan_tree" model="ir.ui.view">
        <field name="name">sales.route.plan.tree</field>
        <field name="model">sales.route.plan</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'submitted'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="plan_date"/>
                <field name="user_id"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="supervisor_id"/>
                <field name="auto_assigned"/>
                <field name="accepted_by_salesperson"/>
                <field name="total_planned_calls"/>
                <field name="planned_productive_calls"/>
                <field name="productive_calls"/>
                <field name="unproductive_calls"/>
                <field name="missed_calls"/>
                <field name="kpi_achievement" widget="percentage"/>
                <field name="total_sales_amount" sum="Total Sales"/>
                <field name="assignment_source"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    

    <record id="view_route_plan_kanban_mobile" model="ir.ui.view">
        <field name="name">sales.route.plan.kanban.mobile</field>
        <field name="model">sales.route.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile fsrp-mobile-kanban" default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="plan_date"/>
                <field name="user_id"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="next_client_id"/>
                <field name="next_client_status"/>
                <field name="total_planned_calls"/>
                <field name="checked_in_calls"/>
                <field name="productive_calls"/>
                <field name="unproductive_calls"/>
                <field name="missed_calls"/>
                <field name="visit_compliance"/>
                <field name="kpi_achievement"/>
                <field name="total_sales_amount"/>
                <field name="mtd_visit_count"/>
                <field name="ytd_visit_count"/>
                <field name="mtd_sales_order_count"/>
                <field name="ytd_sales_order_count"/>
                <field name="mtd_sales_amount"/>
                <field name="ytd_sales_amount"/>
                <field name="auto_assigned"/>
                <field name="accepted_by_salesperson"/>
                <field name="assignment_reason"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click fsrp-mobile-card fsrp-plan-card fsrp-state-#{record.state.raw_value}">
                            <div class="fsrp-mobile-card-header">
                                <div>
                                    <strong class="fsrp-mobile-title"><field name="name"/></strong>
                                    <div class="fsrp-mobile-subtitle"><field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/> • <field name="plan_date"/></div>
                                </div>
                                <div><span class="fsrp-status-pill"><field name="state"/></span><span t-if="record.auto_assigned.raw_value" class="badge bg-info ms-1">System Assigned</span></div>
                            </div>
                            <div class="alert alert-info p-2 my-2" t-if="record.auto_assigned.raw_value and !record.accepted_by_salesperson.raw_value">System auto assigned this route to prevent client coverage gaps. You can proceed with it or create your own route plan.</div>
                            <div class="fsrp-next-client-box" t-if="record.next_client_id.raw_value">
                                <span>Next Client</span>
                                <strong><field name="next_client_id"/></strong>
                                <small><field name="next_client_status"/></small>
                            </div>
                            <div class="fsrp-mobile-metrics">
                                <div><span>Planned</span><strong><field name="total_planned_calls"/></strong></div>
                                <div><span>Visited</span><strong><field name="checked_in_calls"/></strong></div>
                                <div><span>Productive</span><strong><field name="productive_calls"/></strong></div>
                                <div><span>Missed</span><strong><field name="missed_calls"/></strong></div>
                            </div>
                            <div class="fsrp-progress-wrap">
                                <span>Visit Compliance</span>
                                <div class="fsrp-progress"><div class="fsrp-progress-bar" t-att-style="'width:' + Math.min(100, record.visit_compliance.raw_value || 0) + '%'"/></div>
                                <strong><field name="visit_compliance"/>%</strong>
                            </div>
                            <div class="fsrp-mobile-actions">
                                <button name="action_create_own_route_instead" type="object" class="btn btn-outline-secondary btn-sm" t-if="record.auto_assigned.raw_value and !record.accepted_by_salesperson.raw_value">Create Own Route</button>
                                <button name="action_start_my_day" type="object" class="btn btn-primary btn-sm">Start My Day</button>
                                <button name="action_next_client" type="object" class="btn btn-secondary btn-sm">Next Client</button>
                                <button name="action_add_new_client" type="object" class="btn btn-secondary btn-sm">Add New Client</button>
                                <button name="action_add_global_client" type="object" class="btn btn-secondary btn-sm">Add Global Client</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_route_plan_form" model="ir.ui.view">
        <field name="name">sales.route.plan.form</field>
        <field name="model">sales.route.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" states="draft" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object" states="submitted" class="btn-primary" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="action_reject" string="Reject" type="object" states="submitted" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="action_add_to_facilitation_sheet" string="Add to Facilitation Sheet" type="object" states="approved,in_progress,done" class="btn-secondary" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="action_create_own_route_instead" string="Create Own Route Instead" type="object" states="draft,approved" class="btn-secondary" attrs="{'invisible': [('auto_assigned','=',False)]}"/>
                    <button name="action_start" string="Start" type="object" states="approved" class="btn-primary"/>
                    <button name="action_start_my_day" string="Start My Day" type="object" states="approved,in_progress" class="btn-primary"/>
                    <button name="action_next_client" string="Next Client" type="object" states="in_progress" class="btn-secondary"/>
                    <button name="action_add_new_client" string="Add New Client" type="object" states="approved,in_progress" class="btn-secondary"/>
                    <button name="action_add_global_client" string="Add Client From Any Route" type="object" states="draft,approved,in_progress" class="btn-secondary"/>
                    <button name="action_optimize_route_sequence" string="Optimize Route" type="object" states="draft,approved,in_progress" class="btn-secondary"/>
                    <button name="action_done" string="Done" type="object" states="in_progress" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" states="approved,in_progress"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group col="4" string="Route Plan Details">
                        <field name="plan_date"/>
                        <field name="user_id"/>
                        <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="supervisor_id"/>
                        <field name="assignment_source" readonly="1"/>
                        <field name="auto_assigned" readonly="1"/>
                        <field name="accepted_by_salesperson" readonly="1"/>
                        <field name="accepted_on" readonly="1"/>
                        <field name="total_sales_amount" readonly="1"/>
                        <field name="next_client_id" readonly="1"/>
                        <field name="next_client_status" readonly="1"/>
                    </group>

                    <div class="alert alert-success" role="alert" style="margin-bottom: 10px;">
                        <strong>Field Pro:</strong> Use <b>Start My Day</b> or <b>Next Client</b> to move through the route faster.
                    </div>
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('auto_assigned','=',False)]}">
                        <strong>System Auto Assigned Route:</strong> This plan was selected by customer frequency, missed calls, inactivity, classification and sales potential.
                        <field name="assignment_reason" readonly="1" nolabel="1"/>
                    </div>

                    <div class="o_row" style="gap: 12px; margin: 12px 0 16px 0; flex-wrap: wrap;">
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">Target Productive</span>
                            <span class="o_stat_value"><field name="planned_productive_calls" nolabel="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">Productive</span>
                            <span class="o_stat_value"><field name="productive_calls" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">Unproductive</span>
                            <span class="o_stat_value"><field name="unproductive_calls" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">Missed</span>
                            <span class="o_stat_value"><field name="missed_calls" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">Visited %</span>
                            <span class="o_stat_value"><field name="visit_compliance" nolabel="1" widget="percentage" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #fafafa;">
                            <span class="o_stat_text">KPI %</span>
                            <span class="o_stat_value"><field name="kpi_achievement" nolabel="1" widget="percentage" readonly="1"/></span>
                        </div>
                    </div>

                    <div class="o_row" style="gap: 12px; margin: 0 0 16px 0; flex-wrap: wrap;">
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">MTD Visits</span>
                            <span class="o_stat_value"><field name="mtd_visit_count" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 135px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">YTD Visits</span>
                            <span class="o_stat_value"><field name="ytd_visit_count" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 145px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">MTD Orders</span>
                            <span class="o_stat_value"><field name="mtd_sales_order_count" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 145px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">YTD Orders</span>
                            <span class="o_stat_value"><field name="ytd_sales_order_count" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 145px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">MTD Sales</span>
                            <span class="o_stat_value"><field name="mtd_sales_amount" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_stat_info" style="min-width: 145px; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 8px; background: #f6fbff;">
                            <span class="o_stat_text">YTD Sales</span>
                            <span class="o_stat_value"><field name="ytd_sales_amount" nolabel="1" readonly="1"/></span>
                        </div>
                    </div>

                    <notebook>
                        <page string="Planned Client Visits">
                            <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                                <button name="action_add_global_client" string="Add Client From Any Route" type="object" class="btn btn-secondary"/>
                                <span style="margin-left: 8px;">Adds a customer to this plan only. The customer keeps their original market route.</span>
                            </div>
                            <field name="line_ids">
                                <tree editable="bottom" decoration-success="status == 'productive'" decoration-danger="status == 'missed'" decoration-warning="status == 'unproductive'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="plan_state" invisible="1"/>
                                    <field name="partner_id" domain="[('customer_rank', '&gt;', 0), ('active', '=', True)]" context="{'default_customer_rank': 1, 'default_user_id': parent.user_id}" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="is_ad_hoc" readonly="1"/>
                                    <field name="expected_call_type"/>
                                        <field name="expected_visit_purpose_id"/>
                                    <field name="expected_visit_purpose" invisible="1"/>
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="note"/>
                                    <field name="status"/>
                                    <field name="unproductive_reason"/>
                                            <field name="unproductive_reason_id"/>
                                    <field name="unproductive_reason_id"/>
                                    <field name="sale_order_numbers" invisible="1"/>
                                    <field name="sale_order_tag_ids" string="Sales Orders" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': False}"/>
                                    <button name="action_view_sale_orders" type="object" string="Open Orders" class="btn-link" attrs="{'invisible': [('sale_order_numbers','=',False)]}"/>
                                    <button name="action_start_visit" type="object" string="Start Visit" class="btn-primary" attrs="{'invisible': ['|', ('status','!=','pending'), ('plan_state','not in',['approved','in_progress'])]}"/>
                                    <button name="action_check_out" type="object" string="Check Out" attrs="{'invisible': [('status','!=','checked_in')]}"/>
                                    <button name="action_mark_unproductive" type="object" string="No Sale" attrs="{'invisible': [('status','not in',['checked_in','checked_out'])]}"/>
                                    <button name="action_mark_missed" type="object" string="Missed" attrs="{'invisible': [('status','!=','pending')]}"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="partner_id" domain="[('customer_rank', '&gt;', 0), ('active', '=', True)]" context="{'default_customer_rank': 1, 'default_user_id': parent.user_id}" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="plan_state" invisible="1"/>
                                        <field name="is_ad_hoc" readonly="1"/>
                                        <field name="expected_call_type"/>
                                        <field name="product_ids" widget="many2many_tags"/>
                                        <field name="status"/>
                                        <field name="visit_id"/>
                                        <field name="sale_order_numbers" invisible="1"/>
                                        <field name="sale_order_tag_ids" string="Sales Orders" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': False}"/>
                                        <button name="action_view_sale_orders" type="object" string="Open Sales Orders" class="btn-secondary" attrs="{'invisible': [('sale_order_numbers','=',False)]}"/>
                                        <button name="action_start_visit" type="object" string="Start Visit" class="btn-primary" attrs="{'invisible': ['|', ('status','!=','pending'), ('plan_state','not in',['approved','in_progress'])]}"/>
                                            <field name="unproductive_reason"/>
                                            <field name="unproductive_reason_id"/>
                                    <field name="unproductive_reason_id"/>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="KPI Details">
                            <group col="4">
                                <field name="planned_productive_calls"/>
                                <field name="planned_unproductive_calls"/>
                                <field name="productive_calls" readonly="1"/>
                                <field name="unproductive_calls" readonly="1"/>
                                <field name="missed_calls" readonly="1"/>
                                <field name="visit_compliance" widget="percentage" readonly="1"/>
                                <field name="off_route_visits" readonly="1"/>
                                <field name="suspicious_visits" readonly="1"/>
                                <field name="kpi_achievement" widget="percentage" readonly="1"/>
                                <field name="total_sales_amount" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <record id="view_route_plan_pivot" model="ir.ui.view">
        <field name="name">sales.route.plan.pivot</field>
        <field name="model">sales.route.plan</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="route_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="plan_date" type="col" interval="month"/>
                <field name="productive_calls" type="measure"/>
                <field name="unproductive_calls" type="measure"/>
                <field name="missed_calls" type="measure"/>
                <field name="total_sales_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_route_plan_graph" model="ir.ui.view">
        <field name="name">sales.route.plan.graph</field>
        <field name="model">sales.route.plan</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="productive_calls" type="measure"/>
                <field name="unproductive_calls" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
