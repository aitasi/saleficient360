<odoo>
    <record id="view_sales_route_facilitation_form_tree" model="ir.ui.view">
        <field name="name">sales.route.facilitation.form.tree</field>
        <field name="model">sales.route.facilitation.form</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="plan_date"/>
                <field name="supervisor_id"/>
                <field name="route_plan_count"/>
                <field name="total_clients"/>
                <field name="total_facilitation_amount" sum="Total Facilitation"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sales_route_facilitation_form_form" model="ir.ui.view">
        <field name="name">sales.route.facilitation.form.form</field>
        <field name="model">sales.route.facilitation.form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" string="Load All Approved Plans" type="object" states="draft,generated" class="btn-secondary" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="%(action_report_sales_route_facilitation_form)d" string="Print Facilitation Form" type="action" states="generated,approved" class="btn-primary"/>
                    <button name="action_approve" string="Approve Facilitation" type="object" states="generated" class="btn-primary" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="generated,cancelled" groups="field_sales_route_plan.group_field_sales_supervisor,field_sales_route_plan.group_field_sales_manager,sales_team.group_sale_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,generated"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group col="4" string="Daily Facilitation Details">
                        <field name="plan_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="supervisor_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="company_id" groups="base.group_multi_company" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="route_plan_count" readonly="1"/>
                        <field name="total_clients" readonly="1"/>
                        <field name="total_facilitation_amount" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Approved Route Plans">
                            <field name="line_ids" attrs="{'readonly': [('state', '=', 'approved')]}" context="{'default_form_id': active_id}">
                                <tree editable="bottom">
                                    <field name="plan_id"/>
                                    <field name="user_id"/>
                                    <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="supervisor_id"/>
                                    <field name="planned_clients"/>
                                    <field name="planned_productive_calls"/>
                                    <field name="approved_state" readonly="1"/>
                                    <field name="facilitation_amount" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <record id="action_sales_route_facilitation_form" model="ir.actions.act_window">
        <field name="name">Daily Facilitation Forms</field>
        <field name="res_model">sales.route.facilitation.form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
