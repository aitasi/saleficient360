<odoo>
    <record id="view_partner_form_route_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.route.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_marketing_history" type="object" class="oe_stat_button" icon="fa-bullhorn">
                    <field name="marketing_history_count" widget="statinfo" string="Marketing"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group" position="inside">
                <group string="Field Sales Route">
                    <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="route_user_id"/>
                    <field name="visit_frequency"/>
                    <field name="customer_classification"/>
                    <field name="route_sales_potential"/>
                    <field name="route_date_added"/>
                    <field name="customer_latitude"/>
                    <field name="customer_longitude"/>
                    <field name="last_purchase_date" readonly="1"/>
                    <field name="days_since_last_purchase" readonly="1"/>
                    <field name="route_customer_age_days" readonly="1"/>
                    <field name="route_age_bucket" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Marketing History" attrs="{'invisible': [('is_company','=',False)]}">
                    <field name="marketing_history_ids" readonly="1">
                        <tree>
                            <field name="visit_date"/>
                            <field name="user_id"/>
                            <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="program_ids" widget="many2many_tags"/>
                            <field name="contact_person_name"/>
                            <field name="contact_person_phone"/>
                            <field name="activity_summary"/>
                            <field name="activity_date_deadline"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_simple_form_route_inherit" model="ir.ui.view">
        <field name="name">res.partner.simple.form.route.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="route_user_id"/>
            </xpath>
        </field>
    </record>
</odoo>
