<odoo>
    <record id="view_smart_reminder_tree" model="ir.ui.view">
        <field name="name">sales.route.smart.reminder.tree</field>
        <field name="model">sales.route.smart.reminder</field>
        <field name="arch" type="xml">
            <tree decoration-danger="priority == 'high' and state == 'open'" decoration-success="state == 'done'">
                <field name="due_date"/><field name="due_date_stop"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="user_id"/>
                <field name="reminder_type"/>
                <field name="priority"/>
                <field name="state"/>
                <button name="action_done" type="object" string="Done" class="btn-primary" attrs="{'invisible': [('state', '!=', 'open')]}"/>
            </tree>
        </field>
    </record>
    <record id="view_smart_reminder_form" model="ir.ui.view">
        <field name="name">sales.route.smart.reminder.form</field>
        <field name="model">sales.route.smart.reminder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Done" class="btn-primary" states="open"/>
                    <button name="action_cancel" type="object" string="Cancel" states="open"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="due_date"/><field name="reminder_type"/><field name="priority"/></group>
                        <group><field name="partner_id"/><field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/><field name="user_id"/><field name="visit_id"/></group>
                    </group>
                    <field name="note" placeholder="Reminder details..."/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_smart_reminder_calendar" model="ir.ui.view">
        <field name="name">sales.route.smart.reminder.calendar</field>
        <field name="model">sales.route.smart.reminder</field>
        <field name="arch" type="xml">
            <calendar string="Smart Reminders" date_start="due_date" date_stop="due_date_stop" color="user_id">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_smart_reminder" model="ir.actions.act_window">
        <field name="name">Smart Reminders</field>
        <field name="res_model">sales.route.smart.reminder</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
