<odoo>
    <record id="view_route_attendance_tree" model="ir.ui.view">
        <field name="name">sales.route.attendance.tree</field>
        <field name="model">sales.route.attendance</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'closed'" decoration-info="state == 'open'">
                <field name="attendance_date"/>
                <field name="user_id"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="start_time"/>
                <field name="start_place"/>
                <field name="end_time"/>
                <field name="end_place"/>
                <field name="duration_hours"/>
                <field name="state"/>
                <button name="action_end_day" type="object" string="End Day" class="btn-primary" attrs="{'invisible': [('state', '!=', 'open')]}"/>
            </tree>
        </field>
    </record>
    <record id="view_route_attendance_form" model="ir.ui.view">
        <field name="name">sales.route.attendance.form</field>
        <field name="model">sales.route.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_end_day" type="object" string="End Day" states="open" class="btn-primary"/><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <group><field name="user_id"/><field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/><field name="attendance_date"/><field name="duration_hours" readonly="1"/></group>
                        <group><field name="start_time" readonly="1"/><field name="start_place" readonly="1"/><field name="end_time" readonly="1"/><field name="end_place" readonly="1"/></group>
                    </group>
                    <group string="GPS Coordinates">
                        <field name="start_latitude" readonly="1"/><field name="start_longitude" readonly="1"/><field name="end_latitude" readonly="1"/><field name="end_longitude" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_route_attendance" model="ir.actions.act_window">
        <field name="name">Field Staff Attendance</field>
        <field name="res_model">sales.route.attendance</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
</odoo>
