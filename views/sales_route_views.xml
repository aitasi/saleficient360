<odoo>
    <record id="view_sales_route_tree" model="ir.ui.view">
        <field name="name">sales.route.tree</field>
        <field name="model">sales.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="area"/>
                <field name="user_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="supervisor_ids" widget="many2many_tags"/>
                <field name="team_id"/>
                <field name="partner_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_sales_route_form" model="ir.ui.view">
        <field name="name">sales.route.form</field>
        <field name="model">sales.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_existing_partners" type="object" class="oe_stat_button" icon="fa-plus" string="Add Existing Customers"/>
                        <button name="action_view_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Customers"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="supervisor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="team_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customers">
                            <p class="text-muted">Use <b>Add Existing Customers</b> to select one or many partners already in Odoo. Use <b>Add a line</b> below to create a new customer directly on this route.</p>
                            <field name="partner_ids" context="{'default_route_id': active_id, 'default_user_id': user_id, 'default_customer_rank': 1}" mode="tree,form">
                                <tree editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="user_id"/>
                                    <field name="visit_frequency"/>
                                    <field name="last_purchase_date"/>
                                    <field name="days_since_last_purchase"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
</odoo>
