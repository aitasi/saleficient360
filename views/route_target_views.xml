
<odoo>
    <record id="view_sales_route_target_tree" model="ir.ui.view">
        <field name="name">sales.route.target.tree</field>
        <field name="model">sales.route.target</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'achieved'" decoration-danger="state == 'expired'" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="target_scope"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="user_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="sales_order_target_amount" string="Invoice / POS Target Amount" sum="Invoice / POS Target"/>
                <field name="achieved_sales_amount" string="Achieved POS Order Amount" sum="Achieved POS Order Amount"/>
                <field name="amount_progress" widget="progressbar"/>
                <field name="sales_order_target_count" sum="Target POS Orders"/>
                <field name="achieved_sales_count" sum="Achieved POS Orders"/>
                <field name="count_progress" widget="progressbar"/>
                <field name="sku_target_count"/>
                <field name="sku_target_qty_total" sum="Target SKU Qty"/>
                <field name="achieved_sku_qty" sum="Achieved SKU Qty"/>
                <field name="sku_progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'achieved'" decoration-danger="state == 'expired'" decoration-info="state == 'in_progress'"/>
            </tree>
        </field>
    </record>

    <record id="view_sales_route_target_kanban" model="ir.ui.view">
        <field name="name">sales.route.target.kanban</field>
        <field name="model">sales.route.target</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="target_scope"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="user_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="sales_order_target_amount" string="Invoice / POS Target Amount"/>
                            <div class="text-muted o_form_label">Existing target values are preserved. Achievement uses Route Visit POS Order Amount.</div>
                <field name="achieved_sales_amount" string="Achieved POS Order Amount"/>
                <field name="achieved_collection_amount" string="Collections"/>
                <field name="achieved_variance_amount" string="Amount Due"/>
                <field name="sales_order_target_count" string="Productive POS Order Target"/>
                <field name="achieved_sales_count"/>
                <field name="amount_progress"/>
                <field name="sku_target_count"/>
                <field name="sku_target_qty_total"/>
                <field name="achieved_sku_qty"/>
                <field name="sku_progress"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="mt-2"><span class="badge badge-primary"><field name="target_scope"/></span></div>
                            <div class="mt-2 text-muted"><field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/> <field name="user_id"/></div>
                            <div class="mt-2"><field name="date_start"/> → <field name="date_end"/></div>
                            <div class="mt-2"><b>POS Order Achievement:</b> <field name="achieved_sales_amount" string="Achieved POS Order Amount"/> / <field name="sales_order_target_amount" string="Invoice / POS Target Amount"/>
                            <div class="text-muted o_form_label">Existing target values are preserved. Achievement uses Route Visit POS Order Amount.</div></div>
                            <div><b>Productive POS Orders:</b> <field name="achieved_sales_count"/> / <field name="sales_order_target_count" string="Productive POS Order Target"/></div>
                            <div class="mt-2"><field name="amount_progress" widget="progressbar"/></div>
                            <div class="mt-2"><b>SKU Qty:</b> <field name="achieved_sku_qty"/> / <field name="sku_target_qty_total"/> (<field name="sku_target_count"/> lines)</div>
                            <div><field name="sku_progress" widget="progressbar"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sales_route_target_form" model="ir.ui.view">
        <field name="name">sales.route.target.form</field>
        <field name="model">sales.route.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_route_visit_invoices" type="object" string="View Route Visit POS Transactions" class="btn-primary"/>
                    <button name="action_view_sales_orders" type="object" string="View Legacy Sales Orders (Reference)" class="btn-secondary"/>
                    <button name="action_view_sku_sales_order_lines" type="object" string="View SKU Achievement" class="btn-secondary"/>
                    <button name="action_recompute_sku_target_performance" type="object" string="Refresh / Track SKU Performance" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. May Route A Target"/></h1></div>
                    <group>
                        <group string="Target Setup">
                            <field name="active"/>
                            <field name="target_scope"/>
                            <field name="route_id" attrs="{'invisible': [('target_scope', 'in', ['salesperson', 'all_routes'])], 'required': [('target_scope', 'in', ['route', 'route_salesperson'])]}" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="user_id" attrs="{'invisible': [('target_scope', 'in', ['route', 'all_routes'])], 'required': [('target_scope', 'in', ['salesperson', 'route_salesperson'])]}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Target Values">
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sales_order_target_amount" string="Invoice / POS Target Amount"/>
                            <div class="text-muted o_form_label">Existing target values are preserved. Achievement uses Route Visit POS Order Amount.</div>
                            <field name="sales_order_target_count" string="Productive POS Order Target"/>
                            <field name="sku_target_count" readonly="1"/>
                            <field name="sku_target_qty_total" readonly="1"/>
                        </group>
                    </group>
                    <group string="Current Achievement" col="4">
                        <field name="achieved_sales_amount" string="Achieved POS Order Amount (from Route Visits)" readonly="1"/>
                        <field name="achieved_collection_amount" string="Collections" readonly="1"/>
                        <field name="achieved_variance_amount" string="Amount Due" readonly="1"/>
                        <field name="remaining_amount" readonly="1"/>
                        <field name="amount_progress" widget="progressbar" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="achieved_sales_count" readonly="1"/>
                        <field name="remaining_count" readonly="1"/>
                        <field name="count_progress" widget="progressbar" readonly="1"/>
                        <field name="achieved_sku_qty" readonly="1"/>
                        <field name="sku_progress" widget="progressbar" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="SKU Targets by Product Category (Measured from POS)">
                            <field name="sku_target_line_ids">
                                <tree editable="bottom" decoration-success="progress &gt;= 100">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_category_id" options="{'no_create_edit': True}"/>
                                    <field name="product_id" options="{'no_create_edit': True}"/>
                                    <field name="target_qty" sum="Target Qty"/>
                                    <field name="target_amount" sum="Invoice Target"/>
                                    <field name="achieved_qty" sum="Achieved Qty" readonly="1"/>
                                    <field name="achieved_amount" sum="POS Achieved Amount" readonly="1"/>
                                    <field name="progress" widget="progressbar" readonly="1"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <record id="view_sales_route_target_search" model="ir.ui.view">
        <field name="name">sales.route.target.search</field>
        <field name="model">sales.route.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="this_month" string="This Month" domain="[('date_start','&lt;=', context_today().strftime('%Y-%m-%d')), ('date_end','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_scope" string="Target For" context="{'group_by':'target_scope'}"/>
                    <filter name="group_route" string="Route" context="{'group_by':'route_id'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_route_target" model="ir.actions.act_window">
        <field name="name">Invoice / POS Targets</field>
        <field name="res_model">sales.route.target</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
