<odoo>
    <record id="view_order_form_route_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.route.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="route_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="route_plan_id"/>
                <field name="route_plan_line_id"/>
                <field name="fsrp_target_id" readonly="1"/>
                <field name="fsrp_transfer_to_pos_available" readonly="1"/>
                <field name="fsrp_pos_receipt_numbers" readonly="1"/>
                <field name="fsrp_pos_order_amount" readonly="1"/>
                <field name="fsrp_pos_paid_amount" readonly="1"/>
                <field name="fsrp_pos_due_amount" readonly="1"/>
                <field name="fsrp_pos_fully_processed" readonly="1"/>
                <field name="fsrp_delivery_state" readonly="1"/>
                <field name="fsrp_delivery_count" readonly="1"/>
                <field name="fsrp_ordered_qty" readonly="1"/>
                <field name="fsrp_delivered_qty" readonly="1"/>
                <field name="fsrp_pending_delivery_qty" readonly="1"/>
                <field name="fsrp_customer_signature" filename="fsrp_customer_signature_filename" widget="image"/>
                <field name="fsrp_customer_signature_filename" invisible="1"/>
                <field name="fsrp_signature_name"/>
                <field name="fsrp_signature_date" readonly="1"/>
                <field name="fsrp_signature_note"/>

            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_fsrp_refresh_target_skus" type="object" string="Refresh Target SKUs" class="btn-secondary"/>
                <button name="action_fsrp_add_target_skus_to_order_lines" type="object" string="Add Target SKUs" class="btn-primary"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Target SKUs">
                    <field name="fsrp_target_sku_line_ids" readonly="1">
                        <tree decoration-success="achievement &gt;= 100">
                            <field name="product_category_id"/>
                            <field name="product_id"/>
                            <field name="target_qty" sum="Target Qty"/>
                            <field name="ordered_qty" sum="Ordered Qty"/>
                            <field name="target_amount" sum="Target Amount"/>
                            <field name="ordered_amount" sum="Ordered Amount"/>
                            <field name="achievement" widget="progressbar"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
